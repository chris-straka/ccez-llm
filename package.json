{
	"name": "ccez-llm",
	"version": "0.5.0",
	"description": "macOS desktop chatbot (Tauri + Svelte 5) — BYOK chat with language-learner aids",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:web": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"tauri:dev": "scripts/tauri-dev.sh",
		"release": "bun scripts/release.ts",
		"unihan": "bun scripts/unihan-extract.ts",
		"cjkdecomp-subset": "bun scripts/cjkdecomp-subset.ts --data /tmp/cjk-decomp/cjk-decomp.txt --out src/lib/cjkdecomp-subset.generated.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-fs": "^2.5.2",
		"@tauri-apps/plugin-haptics": "^2.3.3",
		"@tauri-apps/plugin-notification": "^2.4.0",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"dompurify": "^3.4.15",
		"fflate": "^0.8.3",
		"katex": "^0.18.7",
		"lindera-wasm": "^6.0.0",
		"marked": "^18.0.13",
		"pinyin-pro": "^3.29.4",
		"shiki": "^4.4.3",
		"tesseract.js": "^7.0.0",
		"wanakana": "^5.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.6.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
