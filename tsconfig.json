{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// Indexing an array yields T | undefined: agents paraphrasing
		// chat.messages[i] get the guard from the compiler instead.
		"noUncheckedIndexedAccess": true,
		// Explicit undefined is not a stand-in for absent: matches the
		// codebase's null-vs-absent convention (e.g. replyLang).
		"exactOptionalPropertyTypes": true,
		// No global @types auto-inclusion: @types/node must stay out of the
		// frontend (no process object at runtime). Tooling imports it
		// explicitly from "node:*" instead.
		"types": [],
		"moduleResolution": "bundler"
	}
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// except $lib which is handled by https://svelte.dev/docs/kit/configuration#files
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
