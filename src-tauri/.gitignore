# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android release signing: keystore.properties is generated in CI from
# secrets (see .github/workflows/release.yml). Never commit keystores.
/gen/android/keystore.properties
*.jks
*.keystore

# Dev-build API keys (dev_secrets.rs): never commit.
/.dev-secrets.json
/.dev-secrets.json.tmp
